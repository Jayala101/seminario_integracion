		{
			"name": "Authentication",
			"item": [
				{
					"name": "Token - Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('token', jsonData.token);",
									"    pm.environment.set('token', jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"admin\",\n    \"password\": \"admin\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/token/",
							"host": ["{{base_url}}"],
							"path": ["auth", "token", ""]
						},
						"description": "Obtener token de autenticación"
					},
					"response": []
				},
				{
					"name": "JWT - Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('jwt_access', jsonData.access);",
									"    pm.collectionVariables.set('jwt_refresh', jsonData.refresh);",
									"    pm.environment.set('jwt_access', jsonData.access);",
									"    pm.environment.set('jwt_refresh', jsonData.refresh);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"admin\",\n    \"password\": \"admin\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/jwt/login/",
							"host": ["{{base_url}}"],
							"path": ["auth", "jwt", "login", ""]
						},
						"description": "Obtener tokens JWT (access y refresh)"
					},
					"response": []
				},
				{
					"name": "JWT - Refresh Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('jwt_access', jsonData.access);",
									"    pm.environment.set('jwt_access', jsonData.access);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refresh\": \"{{jwt_refresh}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/jwt/refresh/",
